# Kopieer naar .env en vul aan
SECRET_KEY=kies-een-lange-willekeurige-tekst
DATABASE_URL=sqlite:///voorraadwacht.db

# Login voor de webinterface (leeg = geen login)
BASIC_AUTH_USER=inkoop
BASIC_AUTH_PASSWORD=

# Hoe vaak controleren en vanaf welke wijziging mailen
SCHEDULER_ENABLED=true
CHECK_INTERVAL_MINUTES=60
NOTIFY_MIN_CHANGE_PCT=20

# E-mail (voorbeeld Microsoft 365; Gmail: smtp.gmail.com + app-wachtwoord)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=voorraad@jullie-bedrijf.be
SMTP_PASSWORD=
MAIL_FROM=voorraad@jullie-bedrijf.be
MAIL_TO=inkoop@jullie-bedrijf.be,collega@jullie-bedrijf.be

# Land/munt voor prijzen en voorraad
COUNTRY=BE
CURRENCY=EUR

# Leveranciers – enkel invullen wat je gebruikt
MOUSER_API_KEY=
FARNELL_API_KEY=
FARNELL_STORE=be.farnell.com
TME_TOKEN=
TME_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Nepleverancier om te testen zonder API-sleutels
DEMO_PROVIDER_ENABLED=true
